# PostgreSQL
DB_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://copilot_user:${DB_PASSWORD}@db:5432/copilot_db

# Redis
REDIS_URL=redis://redis:6379/0

# AI provider: auto | api | claude_cli | mock
#   auto       → api if ANTHROPIC_API_KEY is set, else claude_cli if the
#                Claude Code CLI is available, else mock
#   claude_cli → run on your Claude subscription via headless Claude Code.
#                Generate a token on your machine with `claude setup-token`
#                and paste it below. No API key needed.
AI_PROVIDER=auto
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic API — only needed for AI_PROVIDER=api
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-20250514
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Voyage AI embeddings — leave blank to use deterministic local embeddings
VOYAGE_API_KEY=

# Auth
JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
ENCRYPTION_KEY=change-me-32-byte-key

# Files
UPLOAD_DIR=./uploads
